# Google OAuth 2.0 Client ID (Web application type)
# Get one at https://console.cloud.google.com/apis/credentials
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-client-id-here.apps.googleusercontent.com

# Backend also needs the same client ID for token verification
# Add this value in backend/src/main/resources/application.properties as:
# google.client.id=your-client-id-here.apps.googleusercontent.com
